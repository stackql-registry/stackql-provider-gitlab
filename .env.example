# Live smoke-test credentials (copy to .env - gitignored - and fill in).
# `make smoke`, `make smoke-live` and `make validate-complexity` source .env
# when present. The provider is read-only, so a read_api token is enough and
# nothing is ever created.

# Personal access token with the read_api scope (GitLab -> User settings ->
# Access tokens). The same variable the Terraform gitlab provider reads.
GITLAB_TOKEN=glpat-...

# Optional: self-managed host (and port). Resolves the `host` server variable
# via x-stackQL-envVar so queries need no WHERE host clause. Leave unset for
# gitlab.com. (The Terraform provider's GITLAB_BASE_URL carries the REST v4
# path and cannot be reused as a bare host.)
# GITLAB_HOST=gitlab.example.com

# Optional: the group and the seeded fixture project the authenticated smoke
# tier reads (make seed-fixtures creates the project; the group is used for
# group-scoped reads and must be readable by the token). Defaults: the public
# gitlab-org group and the seeded javen-infraql/stackql-provider-smoke project.
# GITLAB_SMOKE_GROUP=stackql
# GITLAB_SMOKE_PROJECT=stackql/stackql-provider-smoke
